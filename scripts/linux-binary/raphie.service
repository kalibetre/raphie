[Unit]
Description=Raphie personal assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raphie
Group=raphie
WorkingDirectory=/opt/raphie/current
Environment=HOME=/var/lib/raphie
EnvironmentFile=/etc/raphie/raphie.conf
LoadCredentialEncrypted=raphie-keyring:/etc/raphie/keyring.cred
ExecStart=/bin/sh /opt/raphie/current/keyring-session.sh /opt/raphie/current/raphie start
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
