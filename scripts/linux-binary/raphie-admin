#!/bin/sh
set -eu
root=/opt/raphie/current
test -r /etc/raphie/raphie.conf || { echo 'Raphie configuration is unavailable.' >&2; exit 1; }
set -a
. /etc/raphie/raphie.conf
set +a
case "${1:-}" in
  update|restore)
    test "$(id -u)" -eq 0 || { echo 'Run this command with sudo.' >&2; exit 1; }
    command=$1
    shift
    exec sh "$root/$command.sh" "$@"
    ;;
  pair|devices)
    test "$(id -u)" -eq 0 || { echo 'Run this command with sudo.' >&2; exit 1; }
    exec runuser -u raphie -- env HOME=/var/lib/raphie DATA_DIRECTORY="$DATA_DIRECTORY" RAPHIE_WEB_ORIGIN="$RAPHIE_WEB_ORIGIN" "$root/raphie" "$@"
    ;;
  health)
    exec "$root/raphie" health
    ;;
  *) exec "$root/raphie" "$@" ;;
esac
