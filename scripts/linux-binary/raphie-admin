#!/bin/sh
set -eu
root=/opt/raphie/current
test -r /etc/raphie/raphie.conf || { echo 'Raphie configuration is unavailable.' >&2; exit 1; }
set -a
. /etc/raphie/raphie.conf
set +a
case "${1:-}" in
  update|restore|uninstall)
    test "$(id -u)" -eq 0 || { echo 'Run this command with sudo.' >&2; exit 1; }
    command=$1
    shift
    exec sh "$root/$command.sh" "$@"
    ;;
  auth)
    # The data belongs to the service account; files made by root would be unreadable to it.
    test "$(id -u)" -eq 0 || { echo 'Run auth commands with sudo.' >&2; exit 1; }
    umask 077
    exec runuser -u raphie -- "$root/raphie" "$@"
    ;;
  health)
    exec "$root/raphie" health
    ;;
  *) exec "$root/raphie" "$@" ;;
esac
