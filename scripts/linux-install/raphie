#!/bin/sh
set -eu
root=/opt/raphie/current
export DATA_DIRECTORY=/var/lib/raphie/data
case "${1:-}" in
  update)
    shift
    if [ "$#" -eq 0 ]; then
      test "$(id -u)" -eq 0 || { echo 'Run update as root.' >&2; exit 1; }
      tmp=$(mktemp -d)
      trap 'rm -rf "$tmp"' EXIT HUP INT TERM
      sh "$root/scripts/linux-install/release-checkout.sh" "$tmp/source"
      sh "$root/scripts/linux-install/update.sh" "$tmp/source"
      exit
    fi
    exec /bin/sh "$root/scripts/linux-install/update.sh" "$@"
    ;;
  auth)
    # The data belongs to the service account; files made by root would be unreadable to it.
    test "$(id -u)" -eq 0 || { echo 'Run auth commands with sudo.' >&2; exit 1; }
    umask 077
    exec runuser -u raphie -- /usr/local/bin/bun "$root/scripts/raphie.ts" "$@"
    ;;
  restore)
    shift
    exec /bin/sh "$root/scripts/linux-install/restore.sh" "$@"
    ;;
esac
exec /usr/local/bin/bun "$root/scripts/raphie.ts" "$@"
