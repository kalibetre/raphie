#!/bin/sh
set -eu
root=/opt/raphie/current
export DATA_DIRECTORY=/var/lib/raphie/data
if [ "${1:-}" = port ]; then
  [ "$#" -eq 1 ] || { echo 'Usage: raphie port' >&2; exit 1; }
  if [ -r /run/raphie/web-port ]; then
    port=$(cat /run/raphie/web-port)
  elif [ -r /etc/raphie/raphie.conf ]; then
    . /etc/raphie/raphie.conf
    port=${RAPHIE_WEB_PORT:-}
  else
    echo 'Web port unavailable while Raphie is stopped; run sudo raphie port.' >&2
    exit 1
  fi
  case "$port" in ''|*[!0-9]*) echo 'Invalid configured web port.' >&2; exit 1 ;; esac
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then echo 'Invalid configured web port.' >&2; exit 1; fi
  printf '%s\n' "$port"
  exit 0
fi
case "${1:-}" in
  set-port)
    exec /bin/sh "$root/scripts/linux-binary/raphie-admin" "$@"
    ;;
  health)
    test -r /etc/raphie/raphie.conf || { echo 'Raphie configuration is unavailable.' >&2; exit 1; }
    set -a
    . /etc/raphie/raphie.conf
    set +a
    ;;
  update)
    shift
    if [ "$#" -eq 0 ]; then
      test "$(id -u)" -eq 0 || { echo 'Run update as root.' >&2; exit 1; }
      tmp=$(mktemp -d)
      trap 'rm -rf "$tmp"' EXIT HUP INT TERM
      sh "$root/scripts/linux-install/release-checkout.sh" "$tmp/source"
      sh "$root/scripts/linux-install/update.sh" "$tmp/source"
      exit
    fi
    exec /bin/sh "$root/scripts/linux-install/update.sh" "$@"
    ;;
  auth)
    # The data belongs to the service account; files made by root would be unreadable to it.
    test "$(id -u)" -eq 0 || { echo 'Run auth commands with sudo.' >&2; exit 1; }
    umask 077
    exec runuser -u raphie -- /usr/local/bin/bun "$root/scripts/raphie.ts" "$@"
    ;;
  restore)
    shift
    exec /bin/sh "$root/scripts/linux-install/restore.sh" "$@"
    ;;
esac
exec /usr/local/bin/bun "$root/scripts/raphie.ts" "$@"
