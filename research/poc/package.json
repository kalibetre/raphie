{
  "name": "raphie-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Throwaway self-hosted Eve + microsandbox capacity experiment",
  "scripts": {
    "build": "eve build",
    "start": "eve start --host 127.0.0.1 --port 4310",
    "mock": "node scripts/mock-model.mjs",
    "smoke:sandbox": "node scripts/sandbox-smoke.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:capacity": "node scripts/test-lifecycle.mjs --capacity",
    "config:check": "varlock load --agent"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "eve": "0.80.1",
    "microsandbox": "0.5.10"
  },
  "devDependencies": {
    "varlock": "1.23.0"
  }
}
