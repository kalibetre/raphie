{
  "name": "raphie",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:runtime dev:web",
    "dev:web": "bun run --filter @raphie/web dev",
    "dev:fixture": "bun packages/runtime/test/browser-fixture.ts",
    "dev:web:fixture": "VITE_RAPHIE_TEST_WORKSPACE=1 RAPHIE_WEB_ORIGIN=http://127.0.0.1:4321 RAPHIE_RUNTIME_URL=http://127.0.0.1:4317 bun run --filter @raphie/web dev --port 4321",
    "dev:runtime": "bun --bun run varlock run -- bun packages/runtime/src/main.ts",
    "build": "bun run --filter @raphie/web build",
    "check": "bun run --workspaces --if-present check",
    "test": "bun test ./scripts ./apps/web/test ./packages/runtime/test --timeout 15000",
    "start": "bun run --parallel dev:runtime start:web",
    "start:web": "bun run --filter @raphie/web start",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings .",
    "typecheck": "bun run check",
    "validate": "bun run format:check && bun run architecture && bun run lint && bun run typecheck && bun run test && bun run build",
    "architecture": "bun scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "varlock": "1.23.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
