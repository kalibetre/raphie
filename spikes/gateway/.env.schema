# @defaultSensitive=false @defaultRequired=infer
# ---
# Loopback web port
# @type=port
PORT=4315

DATA_DIRECTORY=.data

# Optional Discord configuration: set all five together.
# @sensitive
DISCORD_BOT_TOKEN=

DISCORD_APPLICATION_ID=

DISCORD_PUBLIC_KEY=

DISCORD_OWNER_ID=

DISCORD_CHANNEL_ID=

# Optional server ID assertion. Detected from the channel when unset.
DISCORD_GUILD_ID=
