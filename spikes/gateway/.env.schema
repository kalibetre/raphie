# @defaultSensitive=false @defaultRequired=infer
# ---
# Loopback web port
# @type=port
PORT=4315

DATA_DIRECTORY=.data

# Optional Discord configuration: set all five together.
# @sensitive
DISCORD_BOT_TOKEN=

DISCORD_APPLICATION_ID=

DISCORD_PUBLIC_KEY=

DISCORD_OWNER_ID=

DISCORD_CHANNEL_ID=

# Optional server ID assertion. Detected from the channel when unset.
DISCORD_GUILD_ID=

# Conversation model. The key is injected into the server, never sent to the web UI.
RAPHIE_MODEL=anthropic/claude-haiku-5.5

# @sensitive
OPENROUTER_API_KEY=

# Generic MCP connection probe. Used by npm run mcp:check.
# @type=enum(http, sse, stdio)
MCP_TRANSPORT=http

# @type=url
MCP_URL=

# @sensitive
MCP_BEARER_TOKEN=

MCP_COMMAND=

# JSON array of local command arguments.
MCP_ARGS=

# Optional explicit tool round trip; unset means discovery only.
MCP_PROBE_TOOL=

MCP_PROBE_ARGS=
