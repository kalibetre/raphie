{
  "name": "@raphie/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-docs.ts",
    "dev": "bun run sync && astro dev --host 127.0.0.1 --port 4330",
    "build": "bun run sync && astro build",
    "check": "bun run sync && astro sync && tsc --noEmit",
    "preview": "wrangler dev --port 4331",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
