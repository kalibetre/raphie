---
// Page header: the sidebar section as an eyebrow, the title, and the page
// description as a lede, so every guide opens with what it is for.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;

function contains(entry: Entry): boolean {
  return entry.type === "link"
    ? entry.isCurrent
    : entry.entries.some((child) => contains(child));
}

const section = route.sidebar.find(
  (entry) => entry.type === "group" && contains(entry),
)?.label;
---

<header class="raphie-page-header">
  {
    section && (
      <p class="raphie-eyebrow">
        <span class="raphie-eyebrow-dot" aria-hidden="true" />
        {section}
      </p>
    )
  }
  <h1 id="_top">{title}</h1>
  {description && <p class="raphie-lede">{description}</p>}
</header>

<style>
  .raphie-page-header {
    padding-block: 1.25rem 0.25rem;
  }

  .raphie-eyebrow {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 0.85rem;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }

  .raphie-eyebrow-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
  }

  h1 {
    margin: 0;
    font-family: var(--raphie-heading-font);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 2.85rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .raphie-lede {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>
