---
// Page header: the sidebar section as an eyebrow, the title, and the page
// description as a lede, so every guide opens with what it is for.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;

function contains(entry: Entry): boolean {
  return entry.type === "link"
    ? entry.isCurrent
    : entry.entries.some((child) => contains(child));
}

const section = route.sidebar.find(
  (entry) => entry.type === "group" && contains(entry),
)?.label;
---

<header class="raphie-page-header">
  {
    section && (
      <p class="raphie-eyebrow">{section}</p>
    )
  }
  <h1 id="_top">{title}</h1>
  {description && <p class="raphie-lede">{description}</p>}
</header>

<style>
  .raphie-page-header {
    padding-block: 1.25rem 0.25rem;
  }

  .raphie-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .raphie-lede {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>
