# @defaultSensitive=false @defaultRequired=infer
# ---
# Loopback web port
# @type=port
PORT=4316

# Unset: main checkout .data, stable across Git worktrees. Explicit relative paths
# remain relative to this checkout. Never auto-merge separate worktree data.
# @optional
DATA_DIRECTORY=

# Initial model choice. Provider connections are configured in Settings.
RAPHIE_MODEL=anthropic/claude-haiku-5.5

# Product web origin; the runtime remains loopback-only.
# @type=url
RAPHIE_WEB_ORIGIN=http://127.0.0.1:4320

# Local OTLP receiver and trace SQLite storage are owned by the runtime.
# No external collector endpoint or credentials are needed.
OTEL_SERVICE_NAME=raphie-runtime

# Legacy default-bot MCP bootstrap. Retained until explicitly imported in Settings.
# @optional
MCP_TRANSPORT=
# @optional @sensitive
MCP_URL=
# @optional @sensitive
MCP_BEARER_TOKEN=
# @optional
MCP_COMMAND=
# @optional @sensitive
MCP_ARGS=

# Native workspace CLI.
RAPHIE_CONTAINER_BINARY=docker

# Build from packages/runtime/test/fixtures/container/Dockerfile for Slice 2.
RAPHIE_CONTAINER_IMAGE=raphie-workspace:slice2
