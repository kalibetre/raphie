# @defaultSensitive=false @defaultRequired=infer
# ---
# Loopback web port
# @type=port
PORT=4316

DATA_DIRECTORY=.data

# Optional Discord configuration: set all five together.
# @sensitive
DISCORD_BOT_TOKEN=

DISCORD_APPLICATION_ID=

DISCORD_PUBLIC_KEY=

DISCORD_OWNER_ID=

DISCORD_CHANNEL_ID=

# Optional server ID assertion. Detected from the channel when unset.
DISCORD_GUILD_ID=

# Conversation model. The key is injected into the server, never sent to the web UI.
RAPHIE_MODEL=anthropic/claude-haiku-5.5

# @sensitive
OPENROUTER_API_KEY=

# Optional shared MCP connection for approved tool calls.
# @type=enum(http, sse, stdio)
MCP_TRANSPORT=http

# @optional @type=url
MCP_URL=https://agent.tail09b6ca.ts.net:4788/mcp

# @sensitive
MCP_BEARER_TOKEN=

MCP_COMMAND=

# JSON array of local command arguments.
MCP_ARGS=

# Product web origin; the runtime remains loopback-only.
# @type=url
RAPHIE_WEB_ORIGIN=http://127.0.0.1:4320

# Optional Discord bridge; owner and channel restrictions still apply.
# @type=boolean
RAPHIE_DISCORD_ENABLED=false

# Optional self-hosted OTLP/HTTP traces collector. Empty disables export.
# Full trace URL, for example http://127.0.0.1:4318/v1/traces.
# Do not embed credentials or query strings. Prompts/arguments are not exported.
# @optional @type=url
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

OTEL_SERVICE_NAME=raphie-runtime
