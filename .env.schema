# @defaultSensitive=false @defaultRequired=infer
# Reuse existing private configuration without moving or reading its values.
# @import(./research/spikes/gateway/)
# ---
PORT=4316
DATA_DIRECTORY=.data

# Product web origin; the runtime remains loopback-only.
# @type=url
RAPHIE_WEB_ORIGIN=http://127.0.0.1:4320

# Enable after stopping the archived experiment's Discord listener.
# @type=boolean
RAPHIE_DISCORD_ENABLED=false
